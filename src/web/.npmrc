# Dependency-resolution configuration for the PantryChef web client.
#
# Why this file exists (added by setup agent):
#   The project targets React 18 (react ^18.2.0), but the dev dependency
#   @testing-library/react-hooks ^8.0.1 declares a peer range of
#   react "^16.9.0 || ^17.0.0". Under npm 7+ strict peer resolution this
#   produces an ERESOLVE failure and blocks `npm install` / `npm ci`.
#
#   @testing-library/react-hooks is end-of-life for React 18 (its renderHook
#   API was merged into @testing-library/react). Four existing web test files
#   still import it (tests/hooks/*.test.ts), so the dependency cannot simply be
#   dropped. Enabling legacy peer-dep behavior keeps the declared dependency
#   installable and makes installs reproducible across `npm install` and the
#   CI `npm ci` step without altering any source or test code.
legacy-peer-deps=true
